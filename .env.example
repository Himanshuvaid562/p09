# MongoDB Atlas connection string
# Atlas -> your cluster -> Connect -> Drivers -> Node.js
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Database name inside the Atlas cluster
MONGODB_DB=heard_in_class

# Sign login cookies. Generate with: openssl rand -hex 32
AUTH_SECRET=replace-with-a-long-random-string

# Allow students to create their own accounts at /signup
ALLOW_STUDENT_SIGNUP=true

# Optional: set a secret code to enable faculty self-registration at /signup.
# Leave it unset/commented to keep faculty accounts administrator-only.
# Generate one with: openssl rand -hex 16
# FACULTY_INVITE_CODE=change-this-faculty-invite-code

# true on https deployments, false for local plain-http runs
# (defaults to true when NODE_ENV=production)
COOKIE_SECURE=false

# Optional: meaning-based matching with a local Ollama server
# EMBED_URL=http://localhost:11434
# EMBED_MODEL=nomic-embed-text
# SIMILARITY_THRESHOLD=0.65
